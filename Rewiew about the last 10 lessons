<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Review about The Last 10 Lessons</title>

<style>

body{
    margin:0;
    font-family:Arial;
    background:linear-gradient(135deg,#673AB7,#E91E63);
    text-align:center;
    color:white;
}

h1{
    font-size:35px;
    margin-top:30px;
}

.game{
    background:white;
    color:black;
    width:85%;
    max-width:600px;
    margin:30px auto;
    padding:25px;
    border-radius:25px;
    box-shadow:0 5px 15px rgba(0,0,0,.3);
}

#question{
    color:#673AB7;
    font-size:25px;
}

.option{
    display:block;
    width:90%;
    margin:12px auto;
    padding:15px;
    font-size:19px;
    border:none;
    border-radius:15px;
    background:#FFD54F;
    cursor:pointer;
    font-weight:bold;
}

.option:hover{
    background:orange;
    transform:scale(1.03);
}

input[type="text"]{
    width:80%;
    padding:14px;
    font-size:20px;
    border:2px solid #673AB7;
    border-radius:12px;
    text-align:center;
}

select{
    padding:13px;
    font-size:18px;
    border-radius:12px;
    border:2px solid #673AB7;
}

#feedback{
    font-size:24px;
    font-weight:bold;
    margin:20px;
}

#score{
    font-size:22px;
}

#nextBtn{
    padding:14px 30px;
    font-size:20px;
    border:none;
    border-radius:15px;
    background:#FFD54F;
    font-weight:bold;
    cursor:pointer;
    display:none;
}

#result{
    background:white;
    color:black;
    width:85%;
    max-width:600px;
    margin:30px auto;
    padding:25px;
    border-radius:25px;
    display:none;
}

</style>

</head>

<body>

<h1>📚 Review about The Last 10 Lessons 🇩🇪</h1>

<div id="game" class="game">

<h2 id="question"></h2>

<div id="answers"></div>

<div id="feedback"></div>

<button id="nextBtn" onclick="nextQuestion()">
➡️ Next
</button>

</div>


<div id="result"></div>


<script>

let questions = [

/* ================= CHOOSE ================= */

{
type:"choose",
question:"1. Wie geht's dir? 😊",
options:[
"Mir geht's gut.",
"Ich wohne in Kairo.",
"Ich komme aus Ägypten."
],
answer:"Mir geht's gut."
},

{
type:"choose",
question:"2. Woher kommst du? 🌍",
options:[
"Ich wohne in Kairo.",
"Ich komme aus Ägypten.",
"Mir geht's gut."
],
answer:"Ich komme aus Ägypten."
},

{
type:"choose",
question:"3. Wo wohnst du? 🏠",
options:[
"Ich wohne in Kairo.",
"Ich komme aus Ägypten.",
"Mir geht's gut."
],
answer:"Ich wohne in Kairo."
},

{
type:"choose",
question:"4. Was ist die Hauptstadt von Deutschland? 🇩🇪",
options:[
"Paris",
"Berlin",
"Madrid"
],
answer:"Berlin"
},

{
type:"choose",
question:"5. Was ist das? 🪑",
options:[
"die Brille",
"der Stuhl",
"das Geld"
],
answer:"der Stuhl"
},


/* ================= COMPLETE ================= */

{
type:"text",
question:"6. Ich komme ______ Ägypten.",
answer:"aus"
},

{
type:"text",
question:"7. Ich wohne ______ Kairo.",
answer:"in"
},

{
type:"text",
question:"8. Mir geht's ______.",
answer:"gut"
},

{
type:"text",
question:"9. ______ ich ins Bad gehen?",
answer:"Darf"
},

{
type:"text",
question:"10. ______, bitte.",
answer:"Toilette"
},


/* ================= MATCH ================= */

{
type:"match",
question:"11. Deutschland 🇩🇪",
options:[
"Berlin",
"Paris",
"Madrid",
"Rom"
],
answer:"Berlin"
},

{
type:"match",
question:"12. Frankreich 🇫🇷",
options:[
"Berlin",
"Madrid",
"Paris",
"Rom"
],
answer:"Paris"
},

{
type:"match",
question:"13. Spanien 🇪🇸",
options:[
"Rom",
"Madrid",
"Paris",
"Berlin"
],
answer:"Madrid"
},

{
type:"match",
question:"14. die Brille 👓",
options:[
"📖 Book",
"👓 Glasses",
"🎒 Bag",
"💵 Money"
],
answer:"👓 Glasses"
},

{
type:"match",
question:"15. das Geld 💵",
options:[
"🪑 Chair",
"💵 Money",
"📖 Book",
"👓 Glasses"
],
answer:"💵 Money"
},


/* ================= TRANSLATE ================= */

{
type:"text",
question:"16. Translate into German: I am from Egypt. 🇪🇬",
answer:"Ich komme aus Ägypten."
},

{
type:"text",
question:"17. Translate into German: I live in Cairo. 🏠",
answer:"Ich wohne in Kairo."
},

{
type:"text",
question:"18. Translate into German: I am fine. 😊",
answer:"Mir geht's gut."
},

{
type:"text",
question:"19. Translate into German: Can I go to the bathroom? 🚽",
answer:"Darf ich ins Bad gehen?"
},

{
type:"text",
question:"20. Translate into German: Bathroom, please. 🚽",
answer:"Toilette, bitte."
},


/* ================= THINGS ================= */

{
type:"choose",
question:"21. Was ist das? 👓",
options:[
"die Brille",
"der Stuhl",
"das Buch"
],
answer:"die Brille"
},

{
type:"choose",
question:"22. Was ist das? 📖",
options:[
"das Geld",
"das Buch",
"die Tasche"
],
answer:"das Buch"
},

{
type:"choose",
question:"23. Was ist das? 🎒",
options:[
"die Tasche",
"die Brille",
"das Heft"
],
answer:"die Tasche"
},

{
type:"choose",
question:"24. Was ist das? 💵",
options:[
"der Stuhl",
"das Geld",
"das Buch"
],
answer:"das Geld"
},

{
type:"choose",
question:"25. Was ist das? 🛋️",
options:[
"der Sessel",
"das Heft",
"die Tasche"
],
answer:"der Sessel"
},


/* ================= COMPLETE ================= */

{
type:"text",
question:"26. Das ist ein ______. 📖",
answer:"Buch"
},

{
type:"text",
question:"27. Das ist eine ______. 🎒",
answer:"Tasche"
},

{
type:"text",
question:"28. Das ist ein ______. 💵",
answer:"Geld"
},

{
type:"text",
question:"29. Darf ich ins ______ gehen? 🚽",
answer:"Bad"
},

{
type:"text",
question:"30. Ich ______ in Kairo. 🏠",
answer:"wohne"
}

];


let currentQuestion = 0;

let score = 0;

let answered = false;


function showQuestion(){

answered = false;

document.getElementById("feedback").innerHTML="";

document.getElementById("nextBtn").style.display="none";


let q = questions[currentQuestion];

document.getElementById("question").innerHTML =
q.question;


let answersDiv =
document.getElementById("answers");

answersDiv.innerHTML="";


if(q.type === "choose" || q.type === "match"){

q.options.forEach(function(option){

let button =
document.createElement("button");

button.className="option";

button.innerHTML=option;

button.onclick=function(){

checkAnswer(option);

};

answersDiv.appendChild(button);

});

}


else if(q.type === "text"){

let input =
document.createElement("input");

input.type="text";

input.id="textAnswer";

input.placeholder="Type your answer...";

answersDiv.appendChild(input);


let button =
document.createElement("button");

button.className="option";

button.innerHTML="✅ Check Answer";

button.onclick=function(){

let answer =
document.getElementById("textAnswer").value.trim();

checkAnswer(answer);

};

answersDiv.appendChild(button);

}

}


function checkAnswer(answer){

if(answered) return;

answered=true;


let q=questions[currentQuestion];


if(answer.toLowerCase() === q.answer.toLowerCase()){

score++;

document.getElementById("feedback").innerHTML=
"✅ Correct! 🎉";

}

else{

document.getElementById("feedback").innerHTML=

"❌ Wrong!"+
"<br>✅ Correct answer: "+
q.answer;

}


document.getElementById("nextBtn").style.display="inline-block";


/* AUTO NEXT AFTER 1.5 SECONDS */

setTimeout(function(){

if(answered){

nextQuestion();

}

},1500);

}


function nextQuestion(){

currentQuestion++;


if(currentQuestion < questions.length){

showQuestion();

}

else{

showResult();

}

}


function showResult(){

document.getElementById("game").style.display="none";


let message="";


if(score === 30){

message="🏆 Perfect! Excellent!";

}

else if(score >= 25){

message="🌟 Very Good!";

}

else if(score >= 20){

message="👏 Good Job!";

}

else if(score >= 15){

message="🙂 Good! Keep Practicing!";

}

else{

message="📚 Keep Studying and Try Again!";

}


document.getElementById("result").style.display="block";


document.getElementById("result").innerHTML=

"<h1>🎉 Review Finished!</h1>"+

"<h2>Your Score: "+
score+
"/30</h2>"+

"<h2>"+
message+
"</h2>";

}


showQuestion();

</script>

</body>

</html>
